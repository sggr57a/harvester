# Custom Tdarr NODE image with NVIDIA CUDA + Real-ESRGAN for true AI upscaling.
#
# The Tdarr *node* is what actually runs transcodes, so the AI tool has to live
# in the node's environment. This image layers Real-ESRGAN (PyTorch/CUDA) and
# the wrapper script on top of the official Tdarr node image, which already
# ships an ffmpeg build with NVENC.
#
# Build (run from the tdarr-plugins/ directory so the script is in context):
#   docker build -f docker/Dockerfile.tdarr-node-realesrgan -t tdarr-node-ai:latest .
#
# Run: requires the NVIDIA driver on the host + nvidia-container-toolkit.
# See docker-compose.yml in this folder for a full example.

FROM ghcr.io/haveagitgat/tdarr_node:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Clone Real-ESRGAN. Weights are downloaded automatically on first run, or you
# can bake them in / mount them at /opt/Real-ESRGAN/weights.
RUN git clone --depth=1 https://github.com/xinntao/Real-ESRGAN.git /opt/Real-ESRGAN
WORKDIR /opt/Real-ESRGAN

# PyTorch CUDA wheels bundle the CUDA runtime, so only the host NVIDIA driver
# + nvidia-container-toolkit are required (no full CUDA toolkit in the image).
# Adjust cu121 to match your driver if needed (cu118 / cu124, etc.).
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      torch torchvision --index-url https://download.pytorch.org/whl/cu121 \
 && python3 -m pip install --no-cache-dir --break-system-packages \
      "numpy<2" basicsr facexlib gfpgan \
 && python3 -m pip install --no-cache-dir --break-system-packages -r requirements.txt \
 && python3 setup.py develop

# Fix the well-known basicsr/torchvision incompatibility
# ("cannot import name 'rgb_to_grayscale' from torchvision.transforms.functional_tensor").
RUN BASICSR_DEG=$(python3 -c "import basicsr, os; print(os.path.join(os.path.dirname(basicsr.__file__), 'data', 'degradations.py'))") \
 && sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' "$BASICSR_DEG" || true

# Install the wrapper script.
COPY scripts/tdarr-upscale-ai.sh /usr/local/bin/tdarr-upscale-ai.sh
RUN chmod +x /usr/local/bin/tdarr-upscale-ai.sh

ENV REALESRGAN_DIR=/opt/Real-ESRGAN

# Return to the node's normal working directory/entrypoint from the base image.
WORKDIR /home/Tdarr
