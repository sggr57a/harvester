+    expect(oscilloscope).not.toContain('Math.random');
+    expect(fft).not.toContain('Math.random');
+    expect(oscilloscope).toContain('CH1');
+    expect(oscilloscope).toContain('CH2');
+    expect(oscilloscope).toContain('CH3');
+  });
+});
