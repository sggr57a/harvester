+
+const WAZUH = JSON.stringify({
+  timestamp: '2026-08-18T19:00:03.000Z',
+  rule: { id: '5715', level: 3, description: 'sshd: authentication success.', groups: ['syslog', 'sshd', 'authentication_success'] },
+  agent: { name: 'compute-01' },
+  data: { srcip: '10.0.0.9' },
