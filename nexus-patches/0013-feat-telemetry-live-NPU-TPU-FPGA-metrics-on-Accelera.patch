+    features: [],
+    numaPinning: [],
+    passThrough: rows.map(mapLivePassThrough),
+    nestedClusters: [],
+    dpdkPorts: [],
+    spdkLanes: [],
+    available: true,
+    issues: live.issues ?? [],
+    waitingForHardware: live.waitingForHardware ?? [],
