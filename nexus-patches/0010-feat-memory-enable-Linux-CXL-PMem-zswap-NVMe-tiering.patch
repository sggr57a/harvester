+  write(join(t.sys, 'devices/system/node/node3/distance'), '41 40 21 10\n');
+  write(join(t.sys, 'devices/system/node/node3/meminfo'), 'Node 3 MemTotal: 67108864 kB\nNode 3 MemUsed: 2097152 kB\n');
