+  write(join(t.sys, 'bus/dax/devices/dax0.0/size'), `${128 * 1024 * 1024 * 1024}\n`);
+  write(join(t.sys, 'bus/dax/devices/dax0.0/target_node'), '4\n');
+  write(join(t.sys, 'bus/dax/devices/dax0.0/align'), '2097152\n');
